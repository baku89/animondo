@font-face
	font-family 'BBB Sprat'
	src url('./fonts/BBBSprat-Regularlight.otf') format('opentype')
	font-weight 300
	font-style normal
	font-display swap

@font-face
	font-family 'BBB Sprat'
	src url('./fonts/BBBSprat-Regular.otf') format('opentype')
	font-weight 400
	font-style normal
	font-display swap

:root
	-webkit-text-size-adjust 100%
	interpolate-size allow-keywords

	// The About panel's column. The title is set to the same measure, in the
	// panel and on the loading screen alike — wider and it reads stretched.
	--panel-width 36rem
	// unquote, or Stylus evaluates min() itself and cannot compare a var()
	// against a length — it silently picked 86vw
	--title-width unquote('min(var(--panel-width), 86vw)')

*, &::before, &::after
	-webkit-appearance none
	appearance none
	box-sizing border-box
	margin 0
	padding 0
	text-indent 0
	color inherit
	font-size inherit
	font-weight inherit
	font-family inherit
	line-height inherit
	outline none
	text-decoration none
	background none
	border none
	list-style none

::selection
	background var(--color-text)
	color var(--color-bg)

html, body
	overflow hidden

html
	color black
	font-family 'BBB Sprat', 'a-otf-ryumin-pr6n', serif
	font-weight 300
	font-size 16px

body
	background white

with-alpha($color, $alpha)
	unquote('color-mix(in hsl, ' + $color + ' ' + ($alpha * 100) + '%, transparent)')

.visually-hidden
	position absolute
	width 1px
	height 1px
	margin -1px
	padding 0
	overflow hidden
	clip-path inset(50%)
	white-space nowrap
